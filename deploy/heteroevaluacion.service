[Unit]
Description=Heteroevaluacion por rubrica (Node.js)
After=network.target

[Service]
Type=simple
User=heteroeval
Group=heteroeval
WorkingDirectory=/opt/heteroevaluacion
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/heteroevaluacion/data

[Install]
WantedBy=multi-user.target

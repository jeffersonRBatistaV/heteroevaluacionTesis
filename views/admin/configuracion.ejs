<%- include('../partials/header', { titulo: 'Configuración' }) %>
<%- include('_nav', { tituloPagina: 'Configuración', exportar: false }) %>

<section class="panel panel-pad" style="display:grid; gap:16px; max-width:560px">
  <div>
    <h2>Correo del administrador</h2>
    <p class="muted small">Entras al panel con este correo y tu contraseña. Ahora es <strong><%= correo %></strong>.</p>
  </div>
  <% if (errorCorreo) { %><div class="flash err" role="alert"><%- icono('alerta', 16) %><span><%= errorCorreo %></span></div><% } %>
  <form method="post" action="/admin/configuracion/correo" id="form-correo" style="display:grid; gap:14px">
    <div class="campo">
      <label for="c-correo">Nuevo correo</label>
      <input id="c-correo" name="correo" type="email" maxlength="120" required autocomplete="email" spellcheck="false" placeholder="nombre@unapec.edu.do">
    </div>
    <div class="campo">
      <label for="c-actual-correo">Contraseña actual</label>
      <input id="c-actual-correo" name="actual" type="password" autocomplete="current-password" required>
      <span class="ayuda">Para confirmar que eres tú.</span>
    </div>
    <div class="acciones">
      <button class="btn">Cambiar correo</button>
    </div>
  </form>
</section>

<section class="panel panel-pad" style="display:grid; gap:16px; max-width:560px">
  <div>
    <h2>Contraseña del administrador</h2>
    <p class="muted small">Es la contraseña con la que entras junto con tu correo. Usa al menos 8 caracteres y evita contraseñas fáciles de adivinar.</p>
  </div>
  <% if (error) { %><div class="flash err" role="alert"><%- icono('alerta', 16) %><span><%= error %></span></div><% } %>
  <form method="post" action="/admin/configuracion/clave" id="form-clave" style="display:grid; gap:14px">
    <div class="campo">
      <label for="c-actual">Contraseña actual</label>
      <input id="c-actual" name="actual" type="password" autocomplete="current-password" required>
    </div>
    <div class="campo">
      <label for="c-nueva">Nueva contraseña</label>
      <input id="c-nueva" name="nueva" type="password" autocomplete="new-password" minlength="8" required>
      <span class="ayuda">Mínimo 8 caracteres.</span>
    </div>
    <div class="campo">
      <label for="c-repetir">Repite la nueva contraseña</label>
      <input id="c-repetir" name="repetir" type="password" autocomplete="new-password" minlength="8" required>
    </div>
    <div class="acciones">
      <button class="btn">Cambiar contraseña</button>
      <span class="muted small">Las demás sesiones de administrador se cerrarán.</span>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>

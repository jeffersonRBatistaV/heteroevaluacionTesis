<%- include('partials/header', { titulo: 'Ingreso' }) %>
<section class="inicio">
  <div data-lado="estudiante" <%= modo === 'admin' ? 'hidden' : '' %>>
    <h1>Heteroevaluación de tesis</h1>
    <p class="lead">Ingresa con tu matrícula y tu contraseña para evaluar a tus compañeros de sesión con la rúbrica del curso y consultar tu resultado.</p>
    <ol class="pasos">
      <li><div><strong>Entra con tu matrícula</strong><span>Elige tu sesión y escribe tu matrícula. La primera vez la contraseña también es tu matrícula; luego crearás una propia.</span></div></li>
      <li><div><strong>Evalúa a tus compañeros</strong><span>En cada criterio elige una opción, de <%= escala[0] %> a <%= escala[4] %>.</span></div></li>
      <li><div><strong>Consulta tu resultado</strong><span>Se habilita cuando hayas evaluado al menos al <%= config.porcentajeParaVer %> % de tus compañeros.</span></div></li>
    </ol>
    <p class="small" style="margin-top:22px"><a href="/instructivo">Leer el instructivo completo</a></p>
  </div>

  <div data-lado="admin" <%= modo === 'admin' ? '' : 'hidden' %>>
    <h1>Panel del profesor</h1>
    <p class="lead">Crea sesiones de evaluación, carga la lista de estudiantes, define la rúbrica y el umbral de aprobación, y revisa los resultados.</p>
    <ol class="pasos">
      <li><div><strong>Crea una sesión</strong><span>Con nombre y fecha. Importa la lista desde Excel o agrega a los estudiantes a mano.</span></div></li>
      <li><div><strong>Define la rúbrica y el umbral</strong><span>Elige los criterios, los puntos de cada opción y con cuántos puntos se aprueba.</span></div></li>
      <li><div><strong>Comparte el enlace y revisa</strong><span>Sigue el avance en el dashboard y exporta los resultados a Excel.</span></div></li>
    </ol>
    <p class="small" style="margin-top:22px"><a href="/instructivo#profesores">Leer el instructivo completo</a></p>
  </div>

  <div class="panel entrar" id="ingreso">
    <div class="conmutador" role="group" aria-label="Tipo de acceso">
      <button type="button" data-modo="estudiante" aria-pressed="<%= modo === 'estudiante' %>">Estudiante</button>
      <button type="button" data-modo="admin" aria-pressed="<%= modo === 'admin' %>">Administrador</button>
    </div>

    <form method="post" action="/entrar" class="ingreso-form" data-panel="estudiante" <%= modo === 'admin' ? 'hidden' : '' %> novalidate>
      <% if (fija) { %><input type="hidden" name="codigo" value="<%= fija.codigo %>"><% } %>
      <div>
        <h2>Entrar como estudiante</h2>
        <p class="sub">Tu usuario es tu matrícula, tal como te registró tu profesor.</p>
      </div>
      <div class="campo">
        <label for="sesion">Sesión</label>
        <select id="sesion" name="sesion">
          <% if (!fija) { %><option value="">Elige tu sesión</option><% } %>
          <% const ab = sesiones.filter(s => s.abierta), ce = sesiones.filter(s => !s.abierta); %>
          <% if (ab.length) { %><optgroup label="Sesiones abiertas"><% ab.forEach(s => { %><option value="<%= s.id %>" <%= Number(sesionId) === s.id ? 'selected' : '' %>><%= s.nombre %> · <%= fecha(s.fecha) %></option><% }) %></optgroup><% } %>
          <% if (ce.length) { %><optgroup label="Cerradas (solo consulta)"><% ce.forEach(s => { %><option value="<%= s.id %>" <%= Number(sesionId) === s.id ? 'selected' : '' %>><%= s.nombre %> · <%= fecha(s.fecha) %></option><% }) %></optgroup><% } %>
        </select>
        <span class="ayuda"><%= fija && !fija.abierta ? 'Esta sesión está cerrada: puedes entrar para consultar tus resultados.' : fija ? 'Entraste con el enlace de esta sesión.' : sesiones.length ? 'Ordenadas de la más reciente a la más antigua.' : 'Todavía no hay sesiones.' %></span>
      </div>
      <div class="campo">
        <label for="matricula">Usuario (matrícula)</label>
        <input id="matricula" class="mono-in" name="matricula" value="<%= matricula %>" maxlength="30" required placeholder="2021-0456" autocapitalize="characters" autocomplete="username" spellcheck="false">
      </div>
      <div class="campo">
        <label for="clave-est">Contraseña</label>
        <input id="clave-est" name="clave" type="password" maxlength="100" required autocomplete="current-password">
        <span class="ayuda">La primera vez, tu contraseña es tu matrícula. Después crearás una propia.</span>
      </div>
      <% if (error) { %><p class="error" role="alert"><%- icono('alerta', 16) %><span><%= error %></span></p><% } %>
      <button class="btn grande">Entrar</button>
    </form>

    <form method="post" action="/entrar-admin" class="ingreso-form" data-panel="admin" <%= modo === 'admin' ? '' : 'hidden' %>>
      <div>
        <h2>Entrar como administrador</h2>
        <p class="sub">Gestiona sesiones, rúbricas y resultados.</p>
      </div>
      <div class="campo">
        <label for="clave">Contraseña de administrador</label>
        <input id="clave" name="clave" type="password" autocomplete="current-password" required>
      </div>
      <% if (errorAdmin) { %><p class="error" role="alert"><%- icono('alerta', 16) %><span><%= errorAdmin %></span></p><% } %>
      <button class="btn grande">Entrar como administrador</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>

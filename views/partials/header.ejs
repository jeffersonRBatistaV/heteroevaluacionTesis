<%
  const esPanel = esAdmin && !usuario && ruta.startsWith('/admin');
  const sec = typeof seccion !== 'undefined' ? seccion : '';
  const ctas = typeof cuentas !== 'undefined' ? cuentas : null;
  const rg = typeof rubricaGeneralId !== 'undefined' ? rubricaGeneralId : 1;
  const ico = {
    dashboard: '<path d="M3.5 10.5h5v6h-5zM11.5 3.5h5v13h-5zM3.5 3.5h5v4h-5z"/>',
    sesiones: '<rect x="3" y="4.5" width="14" height="12" rx="2"/><path d="M3 8.5h14M7 2.8v3.4M13 2.8v3.4"/>',
    participantes: '<circle cx="7.5" cy="7" r="2.8"/><path d="M2.5 16.5c.6-2.9 2.6-4.4 5-4.4s4.4 1.5 5 4.4"/><circle cx="14" cy="7.8" r="2.2"/><path d="M13.6 12.3c2 .1 3.4 1.4 3.9 3.7"/>',
    evaluaciones: '<path d="M5 3.5h10v13H5z"/><path d="M7.5 7.5h5M7.5 10.5h5M7.5 13.5h3"/>',
    rubrica: '<path d="M4 4h12M4 8h12M4 12h7M4 16h7"/><path d="M13.5 13.8l1.6 1.6 2.9-3.2"/>',
    configuracion: '<circle cx="10" cy="10" r="2.6"/><path d="M10 2.8v2.1M10 15.1v2.1M2.8 10h2.1M15.1 10h2.1M4.9 4.9l1.5 1.5M13.6 13.6l1.5 1.5M4.9 15.1l1.5-1.5M13.6 6.4l1.5-1.5"/>',
  };
  const icn = (k) => `<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ico[k]}</svg>`;
  const secciones = [
    ['dashboard', '/admin', 'Dashboard', null],
    ['sesiones', '/admin/sesiones', 'Sesiones', ctas && ctas.sesiones],
    ['participantes', '/admin/participantes', 'Participantes', ctas && ctas.participantes],
    ['evaluaciones', '/admin/evaluaciones', 'Evaluaciones', ctas && ctas.evaluaciones],
    ['rubrica', '/admin/rubrica/' + rg, 'Rúbrica general', null],
    ['configuracion', '/admin/configuracion', 'Configuración', null],
  ];
  const btnTutorial = `<button type="button" class="btn sec chico btn-tutorial" id="btn-tutorial" hidden><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M7.9 7.8a2.2 2.2 0 1 1 3 2.1c-.6.3-.9.7-.9 1.3v.4M10 14.2h.01"/></svg>Tutorial</button>`;
%><!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' — ' : '' %>Heteroevaluación de Tesis</title>
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230a0a0a'/%3E%3Cpath d='M10 8v16M22 8v16M10 16h12' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap">
  <link rel="stylesheet" href="/styles.css?v=<%= assetVer %>">
</head>
<body>
<% if (esPanel) { %>
<div class="app">
  <aside class="lateral" aria-label="Administración">
    <a class="marca" href="/admin"><span>Heteroevaluación<small>Panel del profesor</small></span></a>
    <nav class="lateral-nav">
      <% secciones.forEach(([k, href, txt, n]) => { %>
        <a href="<%= href %>" class="<%= sec === k ? 'on' : '' %>"><%- icn(k) %><%= txt %><% if (n != null) { %><span class="cuenta"><%= n %></span><% } %></a>
      <% }) %>
    </nav>
    <div class="lateral-pie">
      <%- btnTutorial %>
      <form method="post" action="/salir"><button class="btn sec chico">Cerrar sesión de administrador</button></form>
    </div>
  </aside>
  <div class="contenido">
    <div class="barra-movil">
      <a class="marca" href="/admin">Heteroevaluación</a>
      <% secciones.forEach(([k, href, txt]) => { %><a class="op <%= sec === k ? 'on' : '' %>" href="<%= href %>"><%= txt %></a><% }) %>
      <div class="derecha"><form method="post" action="/salir"><button class="btn chico">Salir</button></form></div>
    </div>
    <main class="wrap">
<% } else { %>
<header class="top">
  <div class="wrap top-in">
    <a class="marca" href="/"><span>Heteroevaluación<small>de tesis</small></span></a>
    <nav class="nav" aria-label="Principal">
      <% if (usuario) { %>
        <a href="/participantes" class="<%= ruta === '/participantes' || ruta.startsWith('/evaluar') ? 'on' : '' %>">Evaluar</a>
        <a href="/mi-resultado" class="<%= ruta === '/mi-resultado' ? 'on' : '' %>">Mi resultado</a>
      <% } %>
      <% if (esAdmin && !usuario) { %><a href="/admin">Ir al panel</a><% } %>
    </nav>
    <%- btnTutorial %>
    <% if (usuario) { %>
      <form method="post" action="/salir" class="quien">
        <span class="avatar" aria-hidden="true"><%= iniciales(usuario.nombre) %></span>
        <span class="quien-txt"><strong><%= usuario.nombre %></strong><span><%= usuario.sesion_nombre %></span></span>
        <button class="btn sec chico">Salir</button>
      </form>
    <% } %>
  </div>
</header>
<main class="wrap<%= usuario ? ' col-estudiante' : '' %>">
<% } %>
<div class="toasts" aria-live="polite">
  <% if (flashError) { %><div class="flash err" role="alert"><%- icono('alerta', 16) %><span><%= flashError %></span><button type="button" class="cerrar" aria-label="Cerrar aviso">×</button></div><% } %>
  <% if (flash) { %><div class="flash" role="status" data-auto><%- icono('check', 16) %><span><%= flash %></span><button type="button" class="cerrar" aria-label="Cerrar aviso">×</button></div><% } %>
</div>
